# Copy this file to values-secret.yaml and fill in your values before running make install.
# NEVER commit values-secret.yaml to Git. It is listed in .gitignore.
---
version: "2.0"
secrets:
  - name: keycloak-initial-admin
    vaultPrefixes:
      - hub
    fields:
      - name: username
        value: admin
      - name: password
        value: CHANGEME_MIN_12_CHARS

  - name: keycloak-db-secret
    vaultPrefixes:
      - hub
    fields:
      - name: username
        value: keycloak
      - name: password
        value: CHANGEME_MIN_12_CHARS

  # DNS provider credentials for ACME DNS01 cert issuance.
  # Fill in the secret fields for your DNS provider.
  # Route53 example:
  - name: dns-credentials
    vaultPrefixes:
      - hub
    fields:
      - name: secret-access-key
        value: CHANGEME_AWS_SECRET_KEY
      # Cloudflare example (replace the field above with):
      # - name: api-token
      #   value: CHANGEME_CLOUDFLARE_TOKEN
